{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Flink ETL Job Configuration",
  "description": "Flink ETL 工具的任务配置文件格式",
  "type": "object",
  "required": ["job", "sources", "sinks"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema 引用路径"
    },
    "job": {
      "type": "object",
      "description": "Job 基础配置",
      "required": ["name", "mode"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Job 名称"
        },
        "mode": {
          "type": "string",
          "description": "执行模式",
          "enum": ["batch", "streaming"],
          "default": "batch"
        },
        "parallelism": {
          "type": "integer",
          "description": "并行度（可选）",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "description": "数据源配置（支持多个）",
      "items": {
        "type": "object",
        "required": ["type", "outputTable"],
        "properties": {
          "type": {
            "type": "string",
            "description": "Source 类型",
            "enum": ["mysql", "localfile"]
          },
          "outputTable": {
            "type": "string",
            "description": "输出的表名（供下游 Transform 或 Sink 引用）"
          },
          "config": {
            "type": "object",
            "description": "Source 配置参数"
          }
        }
      }
    },
    "transforms": {
      "type": "array",
      "description": "数据转换配置（支持多个，组成处理链）",
      "items": {
        "type": "object",
        "required": ["type", "outputTable", "config"],
        "properties": {
          "type": {
            "type": "string",
            "description": "Transform 类型",
            "enum": ["sql"]
          },
          "outputTable": {
            "type": "string",
            "description": "输出的表名"
          },
          "config": {
            "type": "object",
            "description": "Transform 配置参数",
            "required": ["sql"],
            "properties": {
              "sql": {
                "type": "string",
                "description": "SQL 转换语句，表名为上游的 outputTable"
              }
            }
          }
        }
      }
    },
    "sinks": {
      "type": "array",
      "description": "数据目的地配置（支持多个）",
      "items": {
        "type": "object",
        "required": ["type", "inputTable"],
        "properties": {
          "type": {
            "type": "string",
            "description": "Sink 类型",
            "enum": ["console", "mysql"]
          },
          "inputTable": {
            "type": "string",
            "description": "输入的表名（来自 Source 或 Transform 的 outputTable）"
          },
          "config": {
            "type": "object",
            "description": "Sink 配置参数"
          }
        }
      }
    }
  },
  "definitions": {
    "mysqlSourceConfig": {
      "type": "object",
      "description": "MySQL Source 配置",
      "properties": {
        "url": {
          "type": "string",
          "description": "数据库连接 URL，如 jdbc:mysql://host:port/database",
          "default": "jdbc:mysql://localhost:3306/"
        },
        "table": {
          "type": "string",
          "description": "表名（与 sql 二选一）"
        },
        "sql": {
          "type": "string",
          "description": "自定义查询 SQL（与 table 二选一）"
        },
        "username": {
          "type": "string",
          "description": "用户名"
        },
        "password": {
          "type": "string",
          "description": "密码"
        },
        "splitColumn": {
          "type": "string",
          "description": "分片列名（通常为主键）"
        },
        "batchSize": {
          "type": "integer",
          "description": "批量读取大小",
          "default": 100
        },
        "queryTimeout": {
          "type": "integer",
          "description": "查询超时时间（秒）"
        },
        "schema": {
          "type": "array",
          "description": "字段定义（可选）",
          "items": {
            "$ref": "#/definitions/schemaField"
          }
        }
      }
    },
    "localfileSourceConfig": {
      "type": "object",
      "description": "本地文件 Source 配置",
      "required": ["path", "format", "schema"],
      "properties": {
        "path": {
          "type": "string",
          "description": "文件路径（支持通配符 *）"
        },
        "format": {
          "type": "string",
          "description": "文件格式",
          "enum": ["csv"],
          "default": "csv"
        },
        "encoding": {
          "type": "string",
          "description": "文件编码",
          "default": "UTF-8"
        },
        "delimiter": {
          "type": "string",
          "description": "CSV 分隔符",
          "default": ","
        },
        "skipHeader": {
          "type": "boolean",
          "description": "是否跳过首行",
          "default": true
        },
        "recursive": {
          "type": "boolean",
          "description": "是否递归扫描目录",
          "default": false
        },
        "schema": {
          "type": "array",
          "description": "字段定义（必填）",
          "items": {
            "$ref": "#/definitions/schemaField"
          }
        }
      }
    },
    "mysqlSinkConfig": {
      "type": "object",
      "description": "MySQL Sink 配置",
      "required": ["url", "table", "username", "password"],
      "properties": {
        "url": {
          "type": "string",
          "description": "数据库连接 URL"
        },
        "table": {
          "type": "string",
          "description": "目标表名"
        },
        "username": {
          "type": "string",
          "description": "用户名"
        },
        "password": {
          "type": "string",
          "description": "密码"
        },
        "batchSize": {
          "type": "integer",
          "description": "批量写入大小",
          "default": 100
        }
      }
    },
    "schemaField": {
      "type": "object",
      "description": "字段定义",
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "description": "字段名"
        },
        "type": {
          "type": "string",
          "description": "字段类型",
          "enum": ["INT", "LONG", "STRING", "DOUBLE", "BOOLEAN", "DATE", "TIMESTAMP"]
        }
      }
    }
  }
}