{
  "job": {
    "name": "mysql-custom-sql-to-console",
    "mode": "batch",
    "parallelism": 2
  },
  "sources": [
    {
      "type": "jdbc",
      "outputTable": "source_data",
      "config": {
        "url": "jdbc:mysql://127.0.0.1:3306/test_db",
        "sql": "SELECT id, name, email FROM user_table WHERE age > 11",
        "username": "root",
        "password": "123456",
        "splitKey": "id"
      }
    }
  ],
  "sinks": [
    {
      "type": "console",
      "inputTable": "source_data",
      "config": {}
    }
  ]
}