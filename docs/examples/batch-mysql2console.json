{
  "$schema": "schema/job-config-schema.json",
  "job": {
    "name": "batch-mysql2console",
    "mode": "batch",
    "parallelism": 1
  },
  "sources": [
    {
      "type": "jdbc",
      "outputTable": "source_table",
      "config": {
        "url": "jdbc:mysql://127.0.0.1:3306/test_db",
        "table": "user_table",
        "username": "root",
        "password": "123456"
      }
    }
  ],
  "transforms": [
    {
      "type": "sql",
      "outputTable": "transform_table",
      "config": {
        "sql": "SELECT * FROM source_table WHERE id > 0"
      }
    }
  ],
  "sinks": [
    {
      "type": "console",
      "inputTable": "transform_table"
    }
  ]
}