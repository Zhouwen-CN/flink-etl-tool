{
  "$schema": "schema/job-config-schema.json",
  "job": {
    "name": "batch-mock2doris",
    "mode": "batch",
    "parallelism": 1
  },
  "sources": [
    {
      "type": "mock",
      "outputTable": "source_table",
      "config": {
        "schema": {
          "id": "LONG",
          "name": "STRING",
          "age": "INT",
          "active": "BOOLEAN"
        },
        "data": [
          {
            "id": 1,
            "name": "Alice",
            "age": 25,
            "active": true
          },
          {
            "id": 2,
            "name": "Bob",
            "age": 30,
            "active": false
          },
          {
            "id": 1,
            "name": "Alice Updated",
            "age": 26,
            "active": true
          }
        ]
      }
    }
  ],
  "sinks": [
    {
      "type": "doris",
      "inputTable": "source_table",
      "config": {
        "fenodes": "127.0.0.1:8030",
        "table": "test_db.test_tbl",
        "username": "root",
        "password": "123"
      }
    }
  ]
}
