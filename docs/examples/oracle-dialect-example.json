{
  "job": {
    "name": "oracle-dialect-example",
    "mode": "batch",
    "parallelism": 4
  },
  "sources": [
    {
      "type": "jdbc",
      "outputTable": "source_data",
      "config": {
        "url": "jdbc:oracle:thin:@localhost:1521:orcl",
        "dialect": "oracle",
        "username": "system",
        "password": "oracle",
        "table": "SOURCE_TABLE",
        "splitKey": "ID",
        "batchSize": 1000
      }
    }
  ],
  "transforms": [
    {
      "type": "sql",
      "outputTable": "transformed_data",
      "config": {
        "sql": "SELECT * FROM source_data WHERE id > 0"
      }
    }
  ],
  "sinks": [
    {
      "type": "jdbc",
      "inputTable": "transformed_data",
      "config": {
        "url": "jdbc:oracle:thin:@localhost:1521:orcl",
        "dialect": "oracle",
        "username": "system",
        "password": "oracle",
        "table": "TARGET_TABLE",
        "mode": "upsert",
        "keyFields": ["ID"],
        "batchSize": 100
      }
    }
  ]
}