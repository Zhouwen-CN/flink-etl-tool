{
  "$schema": "schema/job-config-schema.json",
  "job": {
    "name": "stream-modbus2console",
    "mode": "streaming",
    "parallelism": 1
  },
  "sources": [
    {
      "type": "modbus",
      "outputTable": "modbus_data",
      "config": {
        "host": "192.168.1.100:502",
        "deviceId": 1,
        "address": 0,
        "count": 10,
        "intervalMs": 2000
      }
    }
  ],
  "sinks": [
    {
      "type": "console",
      "inputTable": "modbus_data"
    }
  ]
}
