{
  "job": {
    "name": "mysql-to-console",
    "mode": "batch",
    "parallelism": 1
  },
  "source": {
    "type": "mysql",
    "config": {
      "url": "jdbc:mysql://118.145.119.51:3306/test_db",
      "table": "user_table",
      "username": "root",
      "password": "Zw$8rb8*",
      "splitColumn": "id",
      "fetchSize": 1
    }
  },
  "transform": {
    "type": "field-mapping",
    "config": {
      "mappings": [
        { "from": "id", "to": "user_id" },
        { "from": "name", "to": "user_name" }
