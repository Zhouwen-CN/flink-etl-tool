{
  "job": {
    "name": "mysql-to-console",
    "mode": "batch",
    "parallelism": 1
  },
  "sources": [
    {
      "type": "jdbc",
      "outputTable": "users",
      "config": {
        "url": "jdbc:mysql://127.0.0.1:3306/test_db",
        "table": "user_table",
        "username": "root",
        "password": "123456",
        "splitColumn": "id"
      }
    }
  ],
  "transforms": [
    {
      "type": "sql",
      "outputTable": "users_transformed",
      "config": {
        "sql": "SELECT * FROM users WHERE id > 0"
      }
    }
  ],
  "sinks": [
    {
      "type": "console",
      "inputTable": "users_transformed",
      "config": {}
    }
  ]
}