{
  "job": {
    "name": "mysql-to-mysql",
    "mode": "batch",
    "parallelism": 1
  },
  "source": {
    "type": "mysql",
    "outputTable": "source_data",
    "config": {
      "url": "jdbc:mysql://118.145.119.51:3306/test_db",
      "table": "user_table",
      "username": "root",
      "password": "Zw$8rb8*",
      "splitColumn": "id",
      "fetchSize": 1000,
      "schema": [
        { "name": "id", "type": "INT" },
        { "name": "name", "type": "STRING" },
        { "name": "age", "type": "INT" }
      ]
    }
  },
  "transforms": [
    {
      "type": "field-mapping",
      "inputTable": "source_data",
      "outputTable": "mapped_data",
      "config": {
        "mappings": [
          { "from": "id", "to": "id" },
          { "from": "name", "to": "name" },
          { "from": "age", "to": "age" }
        ]
      }
    }
  ],
  "sink": {
    "type": "mysql",
    "inputTable": "mapped_data",
    "config": {
      "url": "jdbc:mysql://118.145.119.51:3306/test_db",
      "table": "user_table_2",
      "username": "root",
      "password": "Zw$8rb8*",
      "batchSize": 100,
      "writeMode": "upsert"
    }
  }
}
