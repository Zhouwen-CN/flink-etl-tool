{
  "job": {
    "name": "mysql-to-mysql",
    "mode": "batch",
    "parallelism": 1
  },
  "sources": [
    {
      "type": "jdbc",
      "outputTable": "source_data",
      "config": {
        "url": "jdbc:mysql://127.0.0.1:3306/test_db",
        "table": "user_table",
        "username": "root",
        "password": "123456",
        "splitKey": "id"
      }
    }
  ],
  "sinks": [
    {
      "type": "jdbc",
      "inputTable": "source_data",
      "config": {
        "url": "jdbc:mysql://127.0.0.1:3306/test_db",
        "sql": "INSERT INTO user_table_2 (id,name,age,email) VALUES(:id,:name,:age,:email) ON DUPLICATE KEY UPDATE name=VALUES(name),age=VALUES(age),email=VALUES(email)",
        "username": "root",
        "password": "123456"
      }
    }
  ]
}