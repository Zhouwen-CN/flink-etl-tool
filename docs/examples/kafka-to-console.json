{
  "job": {
    "name": "kafka-to-console",
    "mode": "streaming",
    "parallelism": 1
  },
  "sources": [
    {
      "type": "kafka",
      "outputTable": "pas_plan_declare",
      "config": {
        "bootstrapServers": "172.23.108.33:9092",
        "groupId": "etl-consumer",
        "topics": [
          "PUDONG_TOPS5_PAS_PLAN_DECLARE_ETL"
        ],
        "startupMode": "earliest",
        "schema": {
          "op": "string",
          "before": {
            "PPD_STATUS": "string",
            "PPD_ID": "string",
            "PPS_SENDDT": "timestamp"
          },
          "after": {
            "PPD_STATUS": "string",
            "PPD_ID": "string",
            "PPS_SENDDT": "timestamp"
          }
        }
      }
    }
  ],
  "transforms": [
    {
      "type": "sql",
      "outputTable": "pas_plan_declare_etl",
      "config": {
        "sql": "SELECT * FROM pas_plan_declare where op = 'u' and before.PPD_STATUS <> after.PPD_STATUS"
      }
    }
  ],
  "sinks": [
    {
      "type": "console",
      "inputTable": "pas_plan_declare_etl",
      "config": {}
    }
  ]
}