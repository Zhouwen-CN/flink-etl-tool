{
  "job": {
    "name": "kafka-to-console",
    "mode": "stream"
  },
  "sources": [
    {
      "type": "kafka",
      "outputTable": "user_events",
      "config": {
        "bootstrapServers": "118.145.119.51:8080",
        "groupId": "etl-consumer",
        "topics": [
          "test-topic"
        ],
        "startingOffsets": "earliest",
        "schema": {
          "id": "LONG",
          "name": "STRING",
          "hobby": [
            "STRING"
          ],
          "address": {
            "city": "STRING",
            "zipcodes": [
              "INT"
            ]
          },
          "friends": [
            {
              "name": "STRING",
              "age": "INT",
              "tags": [
                "STRING"
              ]
            }
          ]
        }
      }
    }
  ],
  "sinks": [
    {
      "type": "console",
      "inputTable": "user_events",
      "config": {}
    }
  ]
}