{
  "job": {
    "name": "csv-to-console",
    "mode": "batch",
    "parallelism": 2
  },
  "source": {
    "type": "localfile",
    "config": {
      "path": "docs/examples/data/*.csv",
      "format": "csv",
      "recursive": false,
      "encoding": "UTF-8",
      "delimiter": ",",
      "header": true
    }
  },
  "sink": {
    "type": "console",
    "config": {}
  }
}