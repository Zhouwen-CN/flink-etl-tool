{
  "job": {
    "name": "csv-to-console",
    "mode": "batch",
    "parallelism": 2
  },
  "source": {
    "type": "localfile",
    "config": {
      "path": "docs/examples/data/*.csv",
      "format": "csv",
      "recursive": false,
      "encoding": "UTF-8",
      "delimiter": ",",
      "skipHeader": true,
      "schema": {
        "fields": [
          {"name": "id", "type": "long"},
          {"name": "name", "type": "string"},
          {"name": "age", "type": "int"},
          {"name": "email", "type": "string"}
        ]
      }
    }
  },
  "sink": {
    "type": "console",
    "config": {}
  }
}