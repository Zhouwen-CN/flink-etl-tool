{
  "job": {
    "name": "csv-to-console",
    "mode": "batch",
    "parallelism": 1
  },
  "sources": [
    {
      "type": "localfile",
      "outputTable": "csv_source",
      "config": {
        "path": "docs/examples/data/*.csv",
        "format": "csv",
        "encoding": "UTF-8",
        "delimiter": ",",
        "skipHeader": true,
        "schema": {
          "id": "LONG",
          "name": "STRING",
          "age": "INT",
          "email": "STRING"
        }
      }
    }
  ],
  "transforms": [
    {
      "type": "sql",
      "outputTable": "csv_source_transformed",
      "config": {
        "sql": "SELECT *,hash_code(email) as hash_code FROM csv_source"
      }
    }
  ],
  "sinks": [
    {
      "type": "console",
      "inputTable": "csv_source_transformed"
    }
  ]
}