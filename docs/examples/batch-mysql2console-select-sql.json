{
  "job": {
    "name": "batch-mysql2console-select-sql",
    "mode": "batch",
    "parallelism": 1
  },
  "sources": [
    {
      "type": "jdbc",
      "outputTable": "source_table",
      "config": {
        "url": "jdbc:mysql://127.0.0.1:3306/test_db",
        "table": "user_table",
        "username": "root",
        "password": "123456",
        "sql": "SELECT id, name, email FROM user_table WHERE age > 11",
        "splitKey": "id"
      }
    }
  ],
  "sinks": [
    {
      "type": "console",
      "inputTable": "source_table"
    }
  ]
}