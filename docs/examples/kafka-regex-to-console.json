{
  "job": {
    "name": "kafka-regex-to-console",
    "mode": "streaming"
  },
  "sources": [
    {
      "type": "kafka",
      "outputTable": "metrics",
      "config": {
        "bootstrapServers": "localhost:9092",
        "groupId": "metrics-consumer",
        "topicPattern": "metrics-.*",
        "startingOffsets": "latest",
        "properties": {
          "fetch.max.bytes": "52428800"
        },
        "schema": {
          "metric": "STRING",
          "value": "DOUBLE",
          "tags": ["STRING"]
        }
      }
    }
  ],
  "sinks": [
    {
      "type": "console",
      "inputTable": "metrics",
      "config": {}
    }
  ]
}